# SAIL (Sovereign AI Inference Layer) configuration template.
#
# This .env.example is SAFE to commit (placeholders only).
# Copy it to .env.host and .env.client, fill in real values, and NEVER commit those.
#   cp .env.example .env.host     # fill with the Polar `host` node's values
#   cp .env.example .env.client   # fill with the Polar `client` node's values
#
# Each process loads one file:
#   ENV_FILE=.env.host   ...uvicorn host.daemon:app...
#   ENV_FILE=.env.client ...python -m client.cli...

# ── Payment backend (host: how you RECEIVE) ─────────────────────
# mock     = self-contained (Phase 0 / tests).
# phoenixd = self-custodial node with auto-liquidity (recommended default for hosts).
# lnd      = your own LND node over REST (most sovereign).
# nwc      = client-side: pay from your OWN wallet via Nostr Wallet Connect (NIP-47).
PAYMENTS=lnd
# HOST (PAYMENTS=phoenixd): local phoenixd HTTP API + its auto-generated http-password (secret,
# from ~/.phoenix/phoenix.conf — never commit; provisioning writes it into .env.host).
PHOENIXD_API_URL=http://127.0.0.1:9740
PHOENIXD_API_PASSWORD=
# CLIENT (PAYMENTS=nwc): the wallet connection string. Set here for CLI use, or paste it in the
# GUI (stored at NWC_PATH). It is a SECRET (can spend up to the wallet's budget) — never commit.
NWC_URI=
NWC_PATH=./client_nwc.json
# CLIENT (PAYMENTS=nwc): the wallet connection string. Set here for CLI use, or paste it in the
# GUI (stored at NWC_PATH). It is a SECRET (can spend up to the wallet's budget) — never commit.
NWC_URI=
NWC_PATH=./client_nwc.json

# ── LND connection (THIS process's own node) ─────────────────────
# Copy these three from the node's "Connect" tab in Polar (File Paths sub-tab).
# In .env.host use the `host` node; in .env.client use the `client` node.
LND_REST_HOST=https://127.0.0.1:8081
LND_TLS_CERT_PATH=/home/rob/.polar/networks/1/volumes/lnd/host/tls.cert
LND_MACAROON_PATH=/home/rob/.polar/networks/1/volumes/lnd/host/data/chain/bitcoin/regtest/admin.macaroon

# ── Model backend (host only) ────────────────────────────────────
MODEL=ollama
OLLAMA_MODEL=qwen3:14b
OLLAMA_URL=http://127.0.0.1:11434
# Keep the model warm in VRAM so it doesn't cold-load per request (host).
OLLAMA_KEEP_ALIVE=30m

# ── Host daemon ──────────────────────────────────────────────────
PORT=8001
HOST_ENDPOINT=http://127.0.0.1:8001
PRICE_MSAT_PER_TOKEN=1000
# Metered settlement: tokens are sold in chunks of this size (one L402 payment each), so a
# client pays for tokens actually delivered, not max_tokens. Smaller = tighter metering;
# larger = fewer payments/round-trips (better over Tor). Overpay is bounded to < 1 chunk.
CHUNK_TOKENS=8
# Manual BOLT11 fallback (non-NWC wallets): how long the host holds an unpaid invoice before it
# expires. Client shows it as QR + copy; the host confirms settlement via its own LND.
BOLT11_EXPIRY_SECONDS=600

# ── Discovery backend ────────────────────────────────────────────
# local = ./registry dir (Phase 0).  nostr = real relay publish/subscribe (Phase 1).
REGISTRY=local
# Comma-separated relay URLs (same on host and client). Dev: a local nostr-rs-relay.
NOSTR_RELAYS=ws://127.0.0.1:7777
# HOST ONLY: the host's Nostr secret key (nsec...). Its pubkey becomes the stable listing identity
# + alias. Leave BLANK to auto-generate + persist one on first run (recommended). NEVER commit this.
NOSTR_HOST_NSEC=
# HOST ONLY: where the auto-generated identity key is persisted when NOSTR_HOST_NSEC is blank.
# Secret (gitignored); default is the host data dir. The same key is reused on every reboot.
HOST_KEY_PATH=~/.config/inference-net/host.nsec
# HOST ONLY: re-announce the listing this often (seconds) so it stays fresh on public relays
# (kind-38111 is replaceable, but relays still drop events). 0 disables the heartbeat.
LISTING_REANNOUNCE_SECONDS=300

# ── Transport ────────────────────────────────────────────────────
# clearnet = advertise HOST_ENDPOINT directly (LAN/clearnet).
# tor      = host exposes a .onion service and advertises it; client routes .onion over Tor.
TRANSPORT=clearnet
# HOST ONLY (TRANSPORT=tor): Tor control port + persisted onion key path (key is secret).
TOR_CONTROL_PORT=9051
ONION_KEY_PATH=./onion.key
# CLIENT: Tor SOCKS proxy used to reach .onion endpoints (socks5h = resolve via Tor).
TOR_SOCKS=socks5h://127.0.0.1:9050
# CLIENT: per-read stream timeout (s). Resets each time bytes arrive; covers cold start + Tor RTT.
CLIENT_READ_TIMEOUT=300

# ── Anti-spam + reputation ───────────────────────────────────────
# HOST: leading-zero bits to mine into the listing (NIP-13 PoW). Higher = costlier to spam.
POW_TARGET=16
# CLIENT: reject any discovered listing below this many leading-zero bits.
POW_MIN_DIFFICULTY=8
# CLIENT: local first-party reputation store (success/latency per host). Gitignored.
REPUTATION_PATH=./client_reputation.json
# CLIENT (GUI): local session history (prompt/response/host/sats/timestamp). Gitignored.
HISTORY_PATH=./client_history.json

# ── Moderation (hard safety seam) ────────────────────────────────
# Model allowlist — HOST refuses to serve a model not listed; CLIENT filters discovered
# listings the same way. Set inline names and/or a file (one per line, # comments). Unset =
# permissive (governance of the canonical list is deferred to Phase 4).
MODEL_ALLOWLIST=
MODEL_ALLOWLIST_PATH=
# CSAM image-output matcher. Image models are DISABLED unless this names a real configured
# hash matcher; check_image_output() fails closed (raises) when unset. A real PhotoDNA/NCMEC-
# style hash-DB integration requires org enrollment and is a hard prerequisite for image models.
CSAM_HASHER=
